# Global
ENVIRONMENT=development

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Backend app
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (Neon Postgres URL)
DATABASE_URL=postgresql://USER:PASSWORD@EP-XXXX-XXXX.us-east-2.aws.neon.tech/DB_NAME?sslmode=require
DATABASE_SCHEMA=email_agent

# Redis/Celery
REDIS_URL=redis://redis:6379/0

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=25
OPENAI_MAX_RETRIES=2

# Google OAuth (Gmail-only scopes)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_BASE_URL=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
TELEGRAM_LINK_TOKEN_TTL_MINUTES=30
TELEGRAM_DEFAULT_DIGEST_FREQUENCY=hourly
TELEGRAM_DEFAULT_TIMEZONE=UTC
TELEGRAM_DEFAULT_URGENT_ALERTS_ENABLED=true
TELEGRAM_URGENT_THRESHOLD=5
TELEGRAM_SCHEDULER_ENABLED=true

# Token encryption secret
ENCRYPTION_KEY=CHANGE_ME_WITH_32_CHAR_MIN_SECRET

# Reliability/observability
DIGEST_IDEMPOTENCY_WINDOW_MINUTES=15
LOG_LEVEL=INFO
