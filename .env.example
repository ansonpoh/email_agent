# Global
ENVIRONMENT=development

# Backend app
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Optional comma-separated browser origins. Leave empty for Telegram-only operation.
CORS_ORIGINS=

# Database (Neon Postgres URL)
DATABASE_URL=postgresql://USER:PASSWORD@EP-XXXX-XXXX.us-east-2.aws.neon.tech/DB_NAME?sslmode=require
DATABASE_SCHEMA=email_agent
RUN_DB_MIGRATIONS_ON_STARTUP=true

# Redis/Celery
REDIS_URL=redis://redis:6379/0

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=25
OPENAI_MAX_RETRIES=2

# Google OAuth (Gmail-only scopes)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# For desktop self-hosting with Telegram webhook, set this to:
# https://<your-stable-tunnel-domain>/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Required for webhook mode in production:
# https://<your-stable-tunnel-domain>
TELEGRAM_WEBHOOK_BASE_URL=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
TELEGRAM_DEFAULT_DIGEST_FREQUENCY=hourly
TELEGRAM_DEFAULT_TIMEZONE=UTC
TELEGRAM_DEFAULT_URGENT_ALERTS_ENABLED=true
TELEGRAM_URGENT_THRESHOLD=5
TELEGRAM_SCHEDULER_ENABLED=true
INPROC_SCHEDULER_ENABLED=true
INPROC_SCHEDULER_TICK_SECONDS=60
INPROC_SCHEDULER_GRACE_MINUTES=20
DIRECT_EMAIL_WATCHER_ENABLED=true
DIRECT_EMAIL_WATCH_INTERVAL_MINUTES=10
DIRECT_EMAIL_WATCH_LOOKBACK_HOURS=48
DIRECT_EMAIL_WATCH_MAX_MESSAGES=30
DIRECT_EMAIL_WATCH_NOTIFY_NO_REPLY=false

# Optional: Cloudflare Tunnel token used by docker compose profile "tunnel".
# Run with: docker compose --profile tunnel up -d --build
CLOUDFLARED_TUNNEL_TOKEN=

# Token encryption secret
ENCRYPTION_KEY=CHANGE_ME_WITH_32_CHAR_MIN_SECRET

# Reliability/observability
DIGEST_IDEMPOTENCY_WINDOW_MINUTES=15
LOG_LEVEL=INFO
