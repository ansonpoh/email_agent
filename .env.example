# Global
ENVIRONMENT=development

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Backend app
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Database (replace with Neon connection URL for real usage)
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/email_agent

# Redis/Celery
REDIS_URL=redis://redis:6379/0

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Google OAuth (Gmail-only scopes)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Telegram
TELEGRAM_BOT_TOKEN=

# Token encryption secret
ENCRYPTION_KEY=CHANGE_ME_WITH_32_CHAR_MIN_SECRET
